{
  "name": "aerotune",
  "license": "MIT",
  "private": true,
  "version": "1.5.10",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:contracts": "node scripts/run-contracts.mjs",
    "test:wifi-privacy-contract": "node scripts/check-wifi-privacy-contract.mjs",
    "test:diagnostic-report-privacy": "node scripts/check-diagnostic-report-privacy.mjs",
    "check:release": "pnpm run build && pnpm run test:contracts && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -A warnings -D clippy::correctness -D clippy::suspicious && cargo test --manifest-path src-tauri/Cargo.toml --locked && cargo test --manifest-path vendor/tauri-plugin-updater/Cargo.toml --locked",
    "test:responsive-contract": "node scripts/check-responsive-contract.mjs",
    "test:quick-navigation": "node scripts/check-quick-navigation.mjs",
    "test:cpu-forecast-gate": "node scripts/check-cpu-forecast-gate.mjs",
    "test:memory-pressure": "node scripts/check-memory-pressure.mjs",
    "test:power-estimate": "node scripts/check-power-estimate.mjs",
    "test:process-refresh-policy": "node scripts/check-process-refresh-policy.mjs",
    "test:process-tree-builder": "node scripts/check-process-tree-builder.mjs",
    "benchmark:process-tree-builder": "node scripts/check-process-tree-builder.mjs --bench",
    "test:process-history-trends": "node scripts/check-process-history-trends.mjs",
    "test:refresh-coordinator": "node scripts/check-refresh-coordinator.mjs",
    "test:interaction-latency": "node scripts/check-interaction-latency.mjs",
    "test:memory-slope": "cargo test --manifest-path src-tauri/Cargo.toml memory_slope",
    "test:symptom-focus": "node scripts/check-symptom-focus.mjs",
    "test:resource-evidence": "node scripts/check-resource-evidence.mjs",
    "test:baseline-announcements": "node scripts/check-baseline-announcements.mjs",
    "test:symptom-focus-render": "node scripts/check-symptom-focus-render.mjs",
    "test:render-locality-contract": "node scripts/check-render-locality-contract.mjs",
    "test:ux-contract": "node scripts/check-ux-contract.mjs",
    "test:elevated-test-task-contract": "node scripts/check-elevated-test-task-contract.mjs",
    "test:updater-release-contract": "node scripts/check-updater-release-contract.mjs && node scripts/check-updater-build-guard.mjs",
    "test:github-updater-contract": "node scripts/check-github-updater-contract.mjs",
    "test:updater-release-blockers": "node scripts/check-updater-release-blockers.mjs",
    "measure:updater-artifact-bounds": "node scripts/measure-updater-artifact-bounds.mjs",
    "check:updater-release-ready": "node scripts/check-updater-release-ready.mjs",
    "build:updater-release": "node scripts/build-updater-release.mjs",
    "test:duplicate-csv-contract": "node scripts/check-duplicate-csv.mjs",
    "test:telemetry-contract": "node scripts/check-telemetry-contract.mjs",
    "test:reliability-contract": "node scripts/check-reliability-contract.mjs",
    "test:disk-history": "node scripts/check-disk-history.mjs",
    "benchmark:disk-history": "node scripts/benchmark-disk-history.mjs",
    "test:change-journal": "node scripts/check-change-journal.mjs",
    "test:startup-impact-match": "node scripts/check-startup-impact-match.mjs",
    "test:startup-task-pagination": "node scripts/check-startup-task-pagination.mjs",
    "test:startup-delay-recovery-ux": "node scripts/check-startup-delay-recovery-ux.mjs",
    "test:reliability-per-app": "node scripts/check-reliability-per-app.mjs",
    "test:cleaner-preflight": "cargo test --manifest-path src-tauri/Cargo.toml cleanup_tests",
    "test:version-sync": "node scripts/check-version-sync.mjs",
    "test:network-dns-contract": "node scripts/check-network-dns-contract.mjs",
    "test:network-quality": "cd src-tauri && cargo test ping_probe_errors_do_not_become_packet_loss_measurements",
    "test:network-quality-history": "node scripts/check-network-quality-history.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/guarded-tauri.mjs",
    "icon": "node scripts/gen-logo.mjs && tauri icon scripts/logo.png -o src-tauri/icons"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@tauri-apps/cli": "^2.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
